{
  "name": "nexus-home-3d",
  "version": "1.0.2",
  "description": "Cyberpunk 3D home dashboard card for Home Assistant",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --charset=utf8 --legal-comments=inline --minify --outfile=nexus-home-3d.js",
    "build:dev": "esbuild src/main.js --bundle --format=esm --charset=utf8 --sourcemap --outfile=nexus-home-3d.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "eslint": "9.13.0"
  }
}
